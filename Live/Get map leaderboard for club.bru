meta {
  name: Get map leaderboard for club
  type: http
  seq: 2
}

get {
  url: https://live-services.trackmania.nadeo.live/api/token/leaderboard/group/:groupId/map/:mapUid/club/:clubId/top?offset=0&length=100
  body: none
  auth: none
}

params:query {
  offset: 0
  length: 100
}

params:path {
  clubId: 54676
  groupId: Personal_Best
  mapUid: CMbUs4OzcDEwUcUUfOonUk4bit8
}

headers {
  Authorization: nadeo_v1 t={{liveToken}}
}
