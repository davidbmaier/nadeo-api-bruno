meta {
  name: Get club activities
  type: http
  seq: 23
}

get {
  url: https://live-services.trackmania.nadeo.live/api/token/club/:clubId/activity?length=250&offset=0&active=true
  body: none
  auth: none
}

params:query {
  length: 250
  offset: 0
  active: true
  ~folderId: 0
}

params:path {
  clubId: 26830
}

headers {
  Authorization: nadeo_v1 t={{liveToken}}
}
